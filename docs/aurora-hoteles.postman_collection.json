{
  "info": {
    "name": "Aurora Hoteles API",
    "description": "Colección para probar la API. Ejecuta primero 'Login administrador': guarda el token en la variable {{token}}. 'Crear hotel' guarda el id en {{hotelId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "hotelId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Público",
      "item": [
        {
          "name": "Listar hoteles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hotels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hotels"
              ]
            }
          }
        },
        {
          "name": "Filtrar por nombre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hotels?name=cartagena",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hotels"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "cartagena"
                }
              ]
            }
          }
        },
        {
          "name": "Filtrar por calificación exacta",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hotels?rating=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hotels"
              ],
              "query": [
                {
                  "key": "rating",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Filtrar por calificación mínima",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hotels?minRating=4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hotels"
              ],
              "query": [
                {
                  "key": "minRating",
                  "value": "4"
                }
              ]
            }
          }
        },
        {
          "name": "Nombre y calificación, paginado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hotels?name=aurora&rating=4&page=1&pageSize=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hotels"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "aurora"
                },
                {
                  "key": "rating",
                  "value": "4"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Obtener hotel por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hotels/{{hotelId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hotels",
                "{{hotelId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Administrador",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear hotel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/hotels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hotels"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hotel Postman\",\n  \"city\": \"Cali\",\n  \"address\": \"Calle 5 # 10-20\",\n  \"description\": \"Creado desde Postman\",\n  \"rating\": 4,\n  \"pricePerNight\": 250000,\n  \"imageUrl\": null\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('hotelId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar hotel",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/hotels/{{hotelId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hotels",
                "{{hotelId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hotel Postman\",\n  \"city\": \"Cali\",\n  \"address\": \"Calle 5 # 10-20\",\n  \"description\": \"Creado desde Postman\",\n  \"rating\": 5,\n  \"pricePerNight\": 250000,\n  \"imageUrl\": null\n}"
            }
          }
        },
        {
          "name": "Crear hotel inválido (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/hotels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hotels"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"rating\": 9\n}"
            }
          }
        },
        {
          "name": "Eliminar hotel",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/hotels/{{hotelId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hotels",
                "{{hotelId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
